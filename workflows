
name: CI Pipeline

# Trigger workflow whenever code is pushed
on:
  push:
    branches:
      - main

jobs:
  build:
    name: Build and Test
    runs-on: ubuntu-latest

    steps:
      # Get repository code
      - name: Checkout code
        uses: actions/checkout@v4

      # Display confirmation
      - name: Verify push trigger
        run: echo "GitHub Actions triggered successfully!"

      # Display current branch
      - name: Show branch
        run: echo "Branch: $GITHUB_REF_NAME"
